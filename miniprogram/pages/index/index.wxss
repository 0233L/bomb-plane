/* 首页：玩法两栏卡片 + 地图规格选择（道具版实验玩法） */
.mode-cards {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0 4rpx;
}
.mode-card {
  flex: 1;
  min-width: 0;
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 20rpx;
}
.mode-card.active { border-color: var(--primary); }
.mode-card-title { font-size: 32rpx; font-weight: bold; color: var(--text); }
.mode-card-desc { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin: 8rpx 0 16rpx; }
.card-btn { margin-top: 12rpx !important; }
.props-intro {
  background: var(--bg);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
}
.props-intro-line { font-size: 22rpx; color: var(--text-3); line-height: 1.7; }
/* 弹窗里的道具价格（金色） */
.gold { color: var(--primary); font-weight: bold; }
/* 规则弹窗两栏 tab：经典模式 / 道具模式 */
.rules-tabs { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.rules-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  color: var(--text-2);
}
.rules-tab.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: bold;
}
/* 创建房间 / 人机对战：地图选择下方的并排按钮行（不在卡片框里） */
.home-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.home-actions .btn { flex: 1; }

.spec-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.spec-label { font-size: 26rpx; color: var(--text-3); }
.spec-btn {
  padding: 6rpx 18rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  color: var(--text-2);
}
.spec-btn.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}
.mode-help { display: block; font-size: 24rpx; color: var(--muted); margin-bottom: 8rpx; }

/* 首页：最近房间列表样式 */
.room-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--grid);
}
.room-item:last-child { border-bottom: none; }
.room-tag { color: var(--text-3); flex: 1; }
.names-tag { color: var(--muted); margin-right: 20rpx; max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.room-actions { display: flex; }
.room-actions .link { margin-left: 24rpx; }
.footer-card { margin-top: 20rpx; }
.footer-stats { display: block; text-align: center; color: var(--muted); font-size: 24rpx; margin-top: 16rpx; }

/* 首页：昵称 + 头像行（点头像换头像） */
.avatar-row { display: flex; align-items: center; gap: 8rpx; }
.avatar-hint { font-size: 24rpx; color: var(--muted); }

/* 头像选择弹窗：emoji 网格 */
.avatar-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}
.avatar-option {
  width: 15%;
  box-sizing: border-box;
  text-align: center;
  font-size: 48rpx;
  padding: 8rpx 0;
  border-radius: 8rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
}
.avatar-option:active { background: var(--hover); }
